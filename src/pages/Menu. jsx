import { useEffect, useState } from "react";
import MenuItemCard from "../components/MenuItemCard";

export default function Menu() {
  const [items, setItems] = useState([]);
  const [activeCategory, setActiveCategory] = useState("All");
  const [search, setSearch] = useState("");

  useEffect(() => {
    fetch("/menu.json")
      .then((res) => res.json())
      .then((data) => setItems(data));
  }, []);

  const cuisineCards = [
    {
      key: "Italy",
      title: "Italian Cuisine",
      subtitle: "Classic pasta, pizza, and rich Italian flavor",
      image: "/images/italy.jpg",
    },
    {
      key: "USA",
      title: "American Cuisine",
      subtitle: "Bold comfort food and familiar favorites",
      image: "/images/usa.jpg",
    },
    {
      key: "Arab",
      title: "Arab Cuisine",
      subtitle: "Traditional dishes full of warmth and spices",
      image: "/images/arabia.jpg",
    },
    {
      key: "France",
      title: "French Cuisine",
      subtitle: "Elegant taste with classic French dishes",
      image: "/images/france.jpg",
    },
    {
      key: "Mexico",
      title: "Mexican Cuisine",
      subtitle: "Colorful flavors with spicy and vibrant dishes",
      image: "/images/mexico.jpg",
    },
  ];

  const categories = ["All", ...new Set(items.map((i) => i.category))];

  const filtered = items.filter((item) => {
    const matchesCategory =
      activeCategory === "All" || item.category === activeCategory;

    const matchesSearch = item.name
      .toLowerCase()
      .includes(search.toLowerCase());

    return matchesCategory && matchesSearch;
  });

  return (
    <div className="page">
      <div className="container">
        <h1>Menu</h1>
        <p className="muted">Find your favorite among our dishes</p>

        <div className="cuisine-section">
          <div className="cuisine-grid">
            {cuisineCards.map((cuisine) => (
              <div
                key={cuisine.key}
                className={`cuisine-card ${
                  activeCategory === cuisine.key ? "active" : ""
                }`}
                onClick={() => setActiveCategory(cuisine.key)}
              >
                <img
                  src={cuisine.image}
                  alt={cuisine.title}
                  className="cuisine-image"
                />
                <div className="cuisine-overlay">
                  <h3>{cuisine.title}</h3>
                  <p>{cuisine.subtitle}</p>
                </div>
              </div>
            ))}
          </div>
        </div>

        <div className="menu-categories">
          {categories.map((cat) => (
            <button
              key={cat}
              className={`menu-category ${
                activeCategory === cat ? "active" : ""
              }`}
              onClick={() => setActiveCategory(cat)}
            >
              {cat}
            </button>
          ))}
        </div>

        <input
          className="menu-search"
          placeholder="Search for a dish..."
          value={search}
          onChange={(e) => setSearch(e.target.value)}
        />

        <div className="menu-grid grid grid-3 mt-4">
          {filtered.map((item) => (
            <MenuItemCard key={item.id} item={item} />
          ))}
        </div>
      </div>
    </div>
  );
}
